# Copy to .env and fill in. Never commit .env. Secrets live in Secret Manager.

# ── Vertex routing ────────────────────────────────────────────────────────────
# Set FALSE and supply GOOGLE_API_KEY to fall back to the Gemini API.
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
# Where Cloud Run, Firestore and GCS live.
GOOGLE_CLOUD_LOCATION=
# Where the model is served. gemini-3.5-flash is global-endpoint only today.
VERTEX_MODEL_LOCATION=
GOOGLE_API_KEY=

GEMINI_MODEL=

# ── Firestore ─────────────────────────────────────────────────────────────────
FIRESTORE_DATABASE=

# ── Services ──────────────────────────────────────────────────────────────────
RENDERER_URL=
RENDERER_SHARED_SECRET=

# ── External APIs ─────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=
META_ADS_ACCESS_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Storage ───────────────────────────────────────────────────────────────────
GCS_EVIDENCE_BUCKET=
REPORT_IP_SALT=

# ── Crawl politeness ──────────────────────────────────────────────────────────
CRAWL_USER_AGENT=
CRAWL_MAX_PAGES=
CRAWL_REQUESTS_PER_SECOND=
CRAWL_CONCURRENCY_PER_HOST=
CRAWL_TIMEOUT_SECONDS=

# ── Pub/Sub ───────────────────────────────────────────────────────────────────
PUBSUB_AUDIT_TOPIC=
PUBSUB_AUDIT_SUBSCRIPTION=
PUBSUB_DEAD_LETTER_TOPIC=
PUBSUB_JOB_TOPIC=
WORKER_SHARED_SECRET=
# What a human types into the browser to sign into /console and /dashboard.
# Separate from WORKER_SHARED_SECRET, which authenticates Pub/Sub's pushes.
CONSOLE_PASSWORD=

# ── Concurrency ───────────────────────────────────────────────────────────────
MAX_CONCURRENT_AUDITS=

# Contact verification: DNS lookups only (MX/A), never a message sent.
# Blank defaults to TRUE. FALSE leaves every address at status "unknown".
VERIFY_CONTACTS=

# ── Reply ingestion ───────────────────────────────────────────────────────────
# Path to the OAuth client secrets JSON downloaded from the Google Cloud
# console. Desktop app type. The scopes requested are gmail.readonly and
# gmail.send, nothing wider: see app/tools/gmail.py.
GMAIL_CLIENT_SECRETS=
# Where the resulting token is stored. Defaults to .gmail-token.json in the
# repo root, which .gitignore already excludes. On Cloud Run, mount the token
# from Secret Manager and point this at the mounted file.
GMAIL_TOKEN_PATH=
# The address the console sends from, for display beside the Send button.
OUTREACH_MAILBOX=
# Your name, for {{sender_name}} above the signature line in the templates.
OUTREACH_SENDER_NAME=
# Emails the console will send in one UTC day before refusing. Default 40.
OUTREACH_DAILY_CAP=
# Hosted PNG for the logo under the signature in the HTML part of each email.
# The worker serves one at /static/relay-mark.png. Empty means no logo.
OUTREACH_LOGO_URL=

# The contractor-facing hostname, comma separated if more than one. On it the
# service serves the report and 404s everything else, so trimming the slug off
# a report URL finds nothing rather than a login. Blank leaves the behaviour
# unchanged, so this stays inert until DNS actually points here.
PUBLIC_REPORT_HOST=

# Where `python -m app.cli smoke` checks after a deploy. The public hostname,
# scheme included.
SMOKE_BASE_URL=

# The company line under a drafted outreach email. Blank defaults to
# "Relay for Roofers".
# Unset means "Relay for Roofers"; set and empty means no signature line.
OUTREACH_SIGNATURE=
